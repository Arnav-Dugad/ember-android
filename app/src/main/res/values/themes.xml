<resources>
    <style name="Theme.Ember" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ember_night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Ember.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ember_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_flame</item>
        <item name="postSplashScreenTheme">@style/Theme.Ember</item>
    </style>
</resources>
