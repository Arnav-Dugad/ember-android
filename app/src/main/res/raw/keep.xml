<?xml version="1.0" encoding="utf-8"?>
<!--
  The Google sign-in client id is generated by the google-services plugin and looked up by name
  at runtime (it only exists when google-services.json is present), so the resource shrinker
  can't see it being used. Without this it is stripped from release builds and Google sign-in
  reports "not configured".
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@string/default_web_client_id" />
