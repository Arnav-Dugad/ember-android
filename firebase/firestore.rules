rules_version = '2';

// Ember Firestore rules (Spark plan: there are no Cloud Functions, so these rules ARE the
// server). The contract is docs/DATA_MODEL.md.
//
// Principles:
//  - Default deny. Every path not matched below is closed.
//  - "Adult" means the caller has users/{uid}/private/account, whose create rule only accepts a
//    real birth date at least 18 years ago. Reading anyone else's data requires it.
//  - Users write only their own documents. Matches can only be created when both likes exist
//    (or a demo profile likes back), and neither side has blocked the other.
//  - Photos are JPEG bytes inside documents (no Cloud Storage on Spark), so these same rules
//    decide who can see every image, including private albums.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function isOwner(uid) {
      return isSignedIn() && me() == uid;
    }

    function accountPath(uid) {
      return /databases/$(database)/documents/users/$(uid)/private/account;
    }

    function isAdult() {
      return isSignedIn() && exists(accountPath(me()));
    }

    // Same, but also true while the account doc is being created in this batch.
    function isAdultAfter() {
      return isSignedIn() && existsAfter(accountPath(me()));
    }

    // Sorted uids joined by "_".
    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function matchPath(a, b) {
      return /databases/$(database)/documents/matches/$(pairId(a, b));
    }

    function isMatched(other) {
      return exists(matchPath(me(), other));
    }

    function blocked(a, b) {
      return exists(/databases/$(database)/documents/users/$(a)/blocks/$(b))
        || exists(/databases/$(database)/documents/users/$(b)/blocks/$(a));
    }

    // True when `uid` has blocked the caller.
    function isBlockedBy(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)/blocks/$(me()));
    }

    function matchDoc(matchId) {
      return get(/databases/$(database)/documents/matches/$(matchId));
    }

    function isParticipant(matchId) {
      return isAdult()
        && exists(/databases/$(database)/documents/matches/$(matchId))
        && me() in matchDoc(matchId).data.users;
    }

    function otherIn(users) {
      return users[0] == me() ? users[1] : users[0];
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function optionalString(d, field, maxLen) {
      return !(field in d) || (d[field] is string && d[field].size() <= maxLen);
    }

    function optionalList(d, field, maxSize) {
      return !(field in d) || (d[field] is list && d[field].size() <= maxSize);
    }

    function optionalBool(d, field) {
      return !(field in d) || d[field] is bool;
    }

    function optionalTimestamp(d, field) {
      return !(field in d) || d[field] is timestamp;
    }

    // JPEG bytes stored in a document. 900 KB keeps us well under the 1 MiB document limit.
    function isImage(data) {
      return data is bytes && data.size() > 0 && data.size() <= 900 * 1024;
    }

    // Same cap for any other binary blob (voice intros are AAC audio).
    function isBlob(data) {
      return isImage(data);
    }

    // A voice intro is at most 30 s; one second of slack absorbs encoder rounding.
    function isVoiceDuration(ms) {
      return ms is int && ms >= 500 && ms <= 31000;
    }

    // ---------- age ----------

    function isLeap(y) {
      return (y % 4 == 0 && y % 100 != 0) || y % 400 == 0;
    }

    function daysIn(y, m) {
      return m == 2 ? (isLeap(y) ? 29 : 28) : (m in [4, 6, 9, 11] ? 30 : 31);
    }

    function isRealDate(y, m, d) {
      return y is int && m is int && d is int
        && y >= 1900 && m >= 1 && m <= 12 && d >= 1 && d <= daysIn(y, m);
    }

    // Completed years on today's UTC date. Someone born on Feb 29 has their birthday on Mar 1 in
    // non-leap years, the same as the app's Ages.ageOn().
    function ageOf(y, m, d) {
      return (request.time.month() < m || (request.time.month() == m && request.time.day() < d))
        ? request.time.year() - y - 1
        : request.time.year() - y;
    }

    function accountAge(acct) {
      return ageOf(acct.birthYear, acct.birthMonth, acct.birthDay);
    }

    // The stored profile age must match the birth date. One year of slack absorbs the gap between
    // the phone's local date and UTC around a birthday; adulthood itself is enforced on the
    // account doc, in UTC, with no slack.
    function ageMatches(uid, d) {
      return 'age' in d && d.age is int
        && d.age >= accountAge(getAfter(accountPath(uid)).data) - 1
        && d.age <= accountAge(getAfter(accountPath(uid)).data) + 1;
    }

    // ---------- profiles ----------

    // Coordinates are stored at two decimal places (about 1 km). Anything finer is rejected so a
    // client bug can never leak an exact location.
    function isCoarse(n) {
      return n is number && math.abs(n * 100 - math.round(n * 100)) < 0.0001;
    }

    function validProfile(uid, d) {
      return d.keys().hasOnly([
          'uid', 'name', 'age', 'gender', 'interestedIn', 'bio', 'photos', 'prompts',
          'interests', 'vibes', 'lookingFor', 'heightCm', 'city', 'geohash', 'lat', 'lng',
          'afterDark', 'privateAlbumCount', 'isDemo', 'onboarded', 'createdAt', 'updatedAt',
          'lastActiveAt', 'freeTonightUntil', 'voiceDurationMs',
          // Privacy switches.
          'hideDistance', 'paused'
        ])
        && d.uid == uid
        && ageMatches(uid, d)
        && (!('isDemo' in d) || d.isDemo == false)
        && (!('name' in d) || (d.name is string && d.name.size() >= 1 && d.name.size() <= 40))
        && (!('gender' in d) || d.gender in ['woman', 'man', 'nonbinary'])
        && (!('interestedIn' in d) || (d.interestedIn is list
              && d.interestedIn.size() <= 3
              && d.interestedIn.toSet().hasOnly(['woman', 'man', 'nonbinary'])))
        && optionalString(d, 'bio', 500)
        && optionalList(d, 'photos', 6)
        && optionalList(d, 'prompts', 3)
        && optionalList(d, 'interests', 10)
        && optionalList(d, 'vibes', 6)
        && (!('lookingFor' in d) || d.lookingFor in ['casual', 'dating', 'friends', 'exploring'])
        && (!('heightCm' in d) || d.heightCm == null
              || (d.heightCm is int && d.heightCm >= 120 && d.heightCm <= 230))
        && optionalString(d, 'city', 80)
        && optionalString(d, 'geohash', 5)
        && (!('lat' in d) || (isCoarse(d.lat) && d.lat >= -90 && d.lat <= 90))
        && (!('lng' in d) || (isCoarse(d.lng) && d.lng >= -180 && d.lng <= 180))
        && optionalBool(d, 'afterDark')
        && optionalBool(d, 'onboarded')
        && optionalBool(d, 'hideDistance')
        && optionalBool(d, 'paused')
        && (!('privateAlbumCount' in d) || (d.privateAlbumCount is int
              && d.privateAlbumCount >= 0 && d.privateAlbumCount <= 12))
        && optionalTimestamp(d, 'updatedAt')
        && optionalTimestamp(d, 'lastActiveAt')
        // "Free tonight" lasts at most 6 hours (plus 10 minutes of clock slack). It stays valid on
        // later writes because request.time only moves forward.
        && (!('freeTonightUntil' in d) || d.freeTonightUntil == null
              || (d.freeTonightUntil is timestamp
                  && d.freeTonightUntil <= request.time + duration.value(370, 'm')))
        && (!('voiceDurationMs' in d) || d.voiceDurationMs == null || isVoiceDuration(d.voiceDurationMs));
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || (isAdult() && !isBlockedBy(uid));
      // The discovery deck. Rules can't filter results per document, so a blocker's profile can
      // still come back in this query; the app drops it, and matches and messages are blocked.
      allow list: if isAdult() && request.query.limit <= 300;

      // The age gate writes the account doc and the first profile doc in one batch.
      allow create: if isOwner(uid) && isAdultAfter()
        && validProfile(uid, request.resource.data)
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time);

      allow update: if isOwner(uid) && isAdultAfter()
        && validProfile(uid, request.resource.data)
        && !changed().hasAny(['uid'])
        && (!changed().hasAny(['createdAt'])
              || (!('createdAt' in resource.data) && request.resource.data.createdAt == request.time));

      allow delete: if isOwner(uid);

      // Birth date and terms acceptance. Created once, never edited; deleted with the account.
      match /private/{docId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && docId == 'account'
          && request.resource.data.keys().hasOnly(['birthYear', 'birthMonth', 'birthDay', 'termsVersion', 'termsAcceptedAt'])
          && isRealDate(request.resource.data.birthYear, request.resource.data.birthMonth, request.resource.data.birthDay)
          && ageOf(request.resource.data.birthYear, request.resource.data.birthMonth, request.resource.data.birthDay) >= 18
          && ageOf(request.resource.data.birthYear, request.resource.data.birthMonth, request.resource.data.birthDay) <= 100
          && request.resource.data.termsVersion is string
          && request.resource.data.termsVersion.size() <= 40
          && request.resource.data.termsAcceptedAt == request.time;
        allow update: if false;
        allow delete: if isOwner(uid);
      }

      // Boundaries and turn-ons: visible to the owner and to matches only.
      match /matchOnly/{docId} {
        allow read: if isOwner(uid) || (isAdult() && docId == 'details' && isMatched(uid));
        allow create, update: if isOwner(uid) && isAdult() && docId == 'details'
          && request.resource.data.keys().hasOnly(['boundaries', 'turnOns', 'updatedAt'])
          && optionalList(request.resource.data, 'boundaries', 12)
          && optionalList(request.resource.data, 'turnOns', 12)
          && optionalTimestamp(request.resource.data, 'updatedAt');
        allow delete: if isOwner(uid);
      }

      match /swipes/{targetId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isAdult()
          && targetId != uid
          && request.resource.data.keys().hasOnly(['direction', 'createdAt'])
          && request.resource.data.direction in ['like', 'nope', 'super']
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        // Rewind: within 10 minutes and never after a match. Once the account doc is gone
        // (account deletion), any remaining swipes may be cleared.
        allow delete: if isOwner(uid)
          && !exists(matchPath(uid, targetId))
          && (resource.data.createdAt > request.time - duration.value(10, 'm')
              || !exists(accountPath(uid)));
      }

      // Who liked `uid`. Only `uid` can read them ("Likes you"); rules also use exists() on these
      // to authorize matches.
      match /likedBy/{likerId} {
        allow read: if isOwner(uid) && isAdult();
        allow create: if isOwner(likerId) && isAdult()
          && likerId != uid
          && request.resource.data.keys().hasOnly(['createdAt', 'super'])
          && request.resource.data.createdAt == request.time
          && request.resource.data.super is bool;
        allow update: if false;
        allow delete: if isOwner(likerId);
      }

      match /blocks/{targetId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && isAdult()
          && targetId != uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow update: if false;
      }

      // People who blocked `uid`, written by the blocker next to their block so `uid`'s deck can
      // drop them too. Only `uid` reads the list; only the blocker creates or deletes their entry,
      // and only while (or in the same batch as) their block exists.
      match /hiddenBy/{creatorId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(creatorId) && isAdult()
          && creatorId != uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && existsAfter(/databases/$(database)/documents/users/$(creatorId)/blocks/$(uid));
        allow update: if false;
        allow delete: if isOwner(creatorId);
      }
    }

    // Seeded demo profiles' behaviour. Admin SDK only.
    match /demoMeta/{uid} {
      allow read, write: if false;
    }

    // ---------- public profile photos ----------

    match /images/{imageId} {
      allow get: if isAdult() || (isSignedIn() && resource.data.owner == me());
      allow list: if false;
      allow create: if isAdult()
        && request.resource.data.keys().hasOnly(['owner', 'data', 'createdAt'])
        && request.resource.data.owner == me()
        && isImage(request.resource.data.data)
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.owner == me();
    }

    // ---------- voice intros ----------

    // One AAC clip per user, stored as bytes like photos. Same audience as the profile.
    match /voices/{uid} {
      allow get: if isOwner(uid) || (isAdult() && !isBlockedBy(uid));
      allow list: if false;
      allow create, update: if isOwner(uid) && isAdult()
        && request.resource.data.keys().hasOnly(['owner', 'data', 'durationMs', 'createdAt'])
        && request.resource.data.owner == uid
        && isBlob(request.resource.data.data)
        && isVoiceDuration(request.resource.data.durationMs)
        && request.resource.data.createdAt == request.time;
      allow delete: if isOwner(uid);
    }

    // ---------- matches and chat ----------

    function messageTypes() {
      return ['text', 'image', 'game', 'voice', 'date'];
    }

    // Must match Reactions.all in the app.
    function reactionEmojis() {
      return ['🔥', '❤️', '😂', '😮', '👍'];
    }

    // AAC voice notes are stored like images: bytes in a document, at most 900 KB.
    function isAudio(data) {
      return data is bytes && data.size() > 0 && data.size() <= 900 * 1024;
    }

    // 60 s of recording, plus a second of slack for the encoder's last frame.
    function isVoiceNoteDuration(ms) {
      return ms is int && ms >= 1 && ms <= 61000;
    }

    function validLastMessage(m) {
      return m is map
        && m.keys().hasOnly(['text', 'senderId', 'type', 'sentAt'])
        && m.senderId == me()
        && m.sentAt == request.time
        && m.type in messageTypes()
        && m.text is string && m.text.size() <= 2000;
    }

    match /matches/{matchId} {
      allow get, list: if isAdult() && me() in resource.data.users;

      // Mutual likes (or a demo profile that likes back), no blocks either way. existsAfter lets
      // the like and the match be written in one batch.
      allow create: if isAdult()
        && request.resource.data.keys().hasOnly(['users', 'profiles', 'createdAt', 'superLike', 'isDemo', 'lastMessage', 'lastRead'])
        && request.resource.data.users is list
        && request.resource.data.users.size() == 2
        && request.resource.data.users[0] < request.resource.data.users[1]
        && matchId == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && me() in request.resource.data.users
        && request.resource.data.profiles is map
        && request.resource.data.createdAt == request.time
        && request.resource.data.superLike is bool
        && request.resource.data.isDemo is bool
        && request.resource.data.lastMessage == null
        && request.resource.data.lastRead == {}
        && existsAfter(/databases/$(database)/documents/users/$(otherIn(request.resource.data.users))/likedBy/$(me()))
        && (existsAfter(/databases/$(database)/documents/users/$(me())/likedBy/$(otherIn(request.resource.data.users)))
            || (exists(/databases/$(database)/documents/demoMeta/$(otherIn(request.resource.data.users)))
                && get(/databases/$(database)/documents/demoMeta/$(otherIn(request.resource.data.users))).data.likesBack == true))
        && !blocked(me(), otherIn(request.resource.data.users));

      // A participant may move only their own read marker and/or post the last-message preview.
      allow update: if isAdult()
        && me() in resource.data.users
        && changed().hasOnly(['lastRead', 'lastMessage'])
        && (!changed().hasAny(['lastRead'])
            || (request.resource.data.lastRead is map
                && request.resource.data.lastRead.diff(resource.data.get('lastRead', {})).affectedKeys().hasOnly([me()])
                && request.resource.data.lastRead[me()] is timestamp
                && request.resource.data.lastRead[me()] <= request.time))
        && (!changed().hasAny(['lastMessage']) || validLastMessage(request.resource.data.lastMessage));

      allow delete: if isAdult() && me() in resource.data.users;

      match /typing/{uid} {
        allow read: if isParticipant(matchId);
        allow create, update: if isOwner(uid) && isParticipant(matchId)
          && request.resource.data.keys().hasOnly(['typing', 'updatedAt'])
          && request.resource.data.typing is bool
          && request.resource.data.updatedAt == request.time;
        allow delete: if isParticipant(matchId);
      }

      // Chat photos. Either participant may delete one: the unmatch cleanup, and the recipient
      // of a view-once photo right after viewing it.
      match /images/{imageId} {
        allow read, delete: if isParticipant(matchId);
        allow create: if isParticipant(matchId)
          && request.resource.data.keys().hasOnly(['owner', 'data', 'createdAt'])
          && request.resource.data.owner == me()
          && isImage(request.resource.data.data)
          && request.resource.data.createdAt == request.time;
        allow update: if false;
      }

      // Voice notes: AAC bytes in a document, owned by the sender.
      match /audio/{audioId} {
        allow read, delete: if isParticipant(matchId);
        allow create: if isParticipant(matchId)
          && request.resource.data.keys().hasOnly(['owner', 'data', 'createdAt', 'durationMs'])
          && request.resource.data.owner == me()
          && isAudio(request.resource.data.data)
          && isVoiceNoteDuration(request.resource.data.durationMs)
          && request.resource.data.createdAt == request.time;
        allow update: if false;
      }

      match /messages/{messageId} {
        function users() {
          return matchDoc(matchId).data.users;
        }

        function validReply(r) {
          return r is map
            && r.keys().hasOnly(['id', 'senderId', 'text', 'type'])
            && r.id is string && r.id.size() >= 1 && r.id.size() <= 128
            && r.senderId in users()
            && r.text is string && r.text.size() <= 120
            && r.type in messageTypes();
        }

        function validDate(d) {
          return d is map
            && d.keys().hasOnly(['title', 'detail', 'emoji'])
            && d.title is string && d.title.size() >= 1 && d.title.size() <= 80
            && d.detail is string && d.detail.size() <= 200
            && d.emoji is string && d.emoji.size() <= 16;
        }

        // A participant sets or removes only their own reaction, and only from the fixed set.
        function isOwnReaction() {
          return changed().hasOnly(['reactions'])
            && request.resource.data.reactions is map
            && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([me()])
            && (!(me() in request.resource.data.reactions)
                || request.resource.data.reactions[me()] in reactionEmojis())
            && !blocked(me(), otherIn(users()));
        }

        // The recipient of a view-once photo marks it opened, exactly once.
        function opensViewOnce() {
          return changed().hasOnly(['viewedAt'])
            && resource.data.get('viewOnce', false) == true
            && resource.data.senderId != me()
            && resource.data.get('viewedAt', null) == null
            && request.resource.data.viewedAt == request.time;
        }

        allow read, delete: if isParticipant(matchId);
        allow update: if isParticipant(matchId) && (isOwnReaction() || opensViewOnce());

        allow create: if isParticipant(matchId)
          && !blocked(me(), otherIn(users()))
          && request.resource.data.keys().hasOnly([
               'senderId', 'type', 'text', 'imageId', 'imageBlurhash', 'game', 'createdAt',
               'viewOnce', 'audioId', 'durationMs', 'date', 'replyTo'
             ])
          && request.resource.data.senderId == me()
          && request.resource.data.createdAt == request.time
          && request.resource.data.type in messageTypes()
          && request.resource.data.get('text', '') is string
          && request.resource.data.get('text', '').size() <= 2000
          && (request.resource.data.type != 'text'
                || request.resource.data.get('text', '').size() >= 1)
          && (request.resource.data.type != 'image'
                || (request.resource.data.get('imageId', null) is string
                    && existsAfter(/databases/$(database)/documents/matches/$(matchId)/images/$(request.resource.data.imageId))))
          && (request.resource.data.type == 'image'
                || request.resource.data.get('imageId', null) == null)
          && (request.resource.data.get('imageBlurhash', null) == null
                || (request.resource.data.imageBlurhash is string
                    && request.resource.data.imageBlurhash.size() <= 100))
          && (!('viewOnce' in request.resource.data)
                || (request.resource.data.viewOnce is bool
                    && (request.resource.data.type == 'image' || request.resource.data.viewOnce == false)))
          && (request.resource.data.type != 'game'
                || (request.resource.data.game is map
                    && request.resource.data.game.keys().hasOnly(['mode', 'prompt'])
                    && request.resource.data.game.mode in ['truth', 'dare']
                    && request.resource.data.game.prompt is string
                    && request.resource.data.game.prompt.size() <= 300))
          && (request.resource.data.type == 'game'
                || request.resource.data.get('game', null) == null)
          && (request.resource.data.type != 'voice'
                || (request.resource.data.get('audioId', null) is string
                    && isVoiceNoteDuration(request.resource.data.get('durationMs', null))
                    && existsAfter(/databases/$(database)/documents/matches/$(matchId)/audio/$(request.resource.data.audioId))))
          && (request.resource.data.type == 'voice'
                || (request.resource.data.get('audioId', null) == null
                    && request.resource.data.get('durationMs', null) == null))
          && (request.resource.data.type != 'date' || validDate(request.resource.data.get('date', null)))
          && (request.resource.data.type == 'date' || request.resource.data.get('date', null) == null)
          && (request.resource.data.get('replyTo', null) == null || validReply(request.resource.data.replyTo));
      }
    }

    // ---------- private albums ----------

    match /albums/{ownerId} {
      function accessPath(viewer) {
        return /databases/$(database)/documents/albums/$(ownerId)/access/$(viewer);
      }

      // Read on every photo request, so revoking (deleting the access doc) is instant.
      function accessApproved() {
        return exists(accessPath(me())) && get(accessPath(me())).data.status == 'approved';
      }

      match /photos/{photoId} {
        allow read: if isOwner(ownerId) || (isAdult() && accessApproved());
        allow create: if isOwner(ownerId) && isAdult()
          && request.resource.data.keys().hasOnly(['data', 'createdAt'])
          && isImage(request.resource.data.data)
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(ownerId);
      }

      match /access/{viewerId} {
        allow read: if isOwner(ownerId) || isOwner(viewerId);

        // The viewer asks. Only matches can ask, and a request always starts pending.
        allow create: if isOwner(viewerId) && isAdult()
          && viewerId != ownerId
          && isMatched(ownerId)
          && request.resource.data.keys().hasOnly(['ownerId', 'viewerId', 'status', 'requestedAt', 'updatedAt'])
          && request.resource.data.ownerId == ownerId
          && request.resource.data.viewerId == viewerId
          && request.resource.data.status == 'pending'
          && request.resource.data.requestedAt is timestamp
          && request.resource.data.updatedAt is timestamp;

        // The owner explicitly approves or denies.
        allow update: if isOwner(ownerId) && isAdult()
          && isMatched(viewerId)
          && changed().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['approved', 'denied']
          && request.resource.data.updatedAt is timestamp;

        // Either side can revoke at any time.
        allow delete: if isOwner(ownerId) || isOwner(viewerId);
      }
    }

    // ---------- moderation ----------

    // Today's UTC date as yyyy-MM-dd, the id of the per-day counter docs.
    function pad2(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    function utcDay() {
      return string(request.time.year()) + '-' + pad2(request.time.month()) + '-' + pad2(request.time.day());
    }

    function limitPath(uid, day) {
      return /databases/$(database)/documents/users/$(uid)/limits/$(day);
    }

    // Reports have deterministic ids: {reporterId}_{yyyy-MM-dd}_{n}, n being the day's counter
    // value after this report. Two reports can never share a counter step.
    function reportPath(uid, day, n) {
      return /databases/$(database)/documents/reports/$(uid + '_' + day + '_' + string(n));
    }

    // At most this many reports per reporter per UTC day.
    function maxReportsPerDay() {
      return 20;
    }

    // The report must arrive in the same batch as a +1 on today's counter, and its id must name
    // that step. Without a server, this is what stops one account flooding the moderation queue.
    function countsTowardsLimit(reportId) {
      let path = limitPath(me(), utcDay());
      let before = exists(path) ? get(path).data.reports : 0;
      let after = getAfter(path).data.reports;
      return after == before + 1
        && after <= maxReportsPerDay()
        && reportId == me() + '_' + utcDay() + '_' + string(after);
    }

    // users/{uid}/limits/{yyyy-MM-dd} = { reports: int }. Only today's doc can be written, only
    // in steps of one, and only alongside the report that step stands for. Kept (like reports)
    // when an account is deleted, so deleting it can't reset the limit.
    match /users/{uid}/limits/{day} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isAdult()
        && day == utcDay()
        && request.resource.data.keys().hasOnly(['reports'])
        && request.resource.data.reports == 1
        && existsAfter(reportPath(uid, day, 1));
      allow update: if isOwner(uid) && isAdult()
        && day == utcDay()
        && request.resource.data.keys().hasOnly(['reports'])
        && request.resource.data.reports == resource.data.reports + 1
        && request.resource.data.reports <= maxReportsPerDay()
        && existsAfter(reportPath(uid, day, request.resource.data.reports));
      allow delete: if false;
    }

    // ---- AI chat settings (users/{uid}/ai/config) ----
    // The user's own AI provider choice and API keys, so they follow the login to a new phone.
    // Only the owner can ever read or write it; every field is whitelisted and size-capped.
    function aiProviders() {
      return ['claude', 'gemini', 'openai', 'compatible'];
    }

    function validAiStrings(m, max) {
      return m is map
        && m.keys().hasOnly(aiProviders())
        && (!('claude' in m) || (m.claude is string && m.claude.size() <= max))
        && (!('gemini' in m) || (m.gemini is string && m.gemini.size() <= max))
        && (!('openai' in m) || (m.openai is string && m.openai.size() <= max))
        && (!('compatible' in m) || (m.compatible is string && m.compatible.size() <= max));
    }

    function validAiConfig(d) {
      return d.keys().hasOnly(['provider', 'models', 'baseUrl', 'pace', 'enabled', 'firstMove', 'voiceNotes',
          'immersive', 'monthlyCap', 'keys', 'changedAt', 'updatedAt'])
        && d.provider in aiProviders()
        && validAiStrings(d.models, 120)
        && validAiStrings(d.keys, 400)
        && d.baseUrl is string && d.baseUrl.size() <= 300
        && (d.baseUrl == '' || d.baseUrl.matches('https://.+'))
        && d.pace in ['natural', 'quick']
        && d.enabled is bool && d.firstMove is bool && d.voiceNotes is bool && d.immersive is bool
        && d.monthlyCap is int && d.monthlyCap >= 0 && d.monthlyCap <= 100000
        && d.changedAt is int
        && d.updatedAt == request.time;
    }

    match /users/{uid}/ai/{docId} {
      allow read, delete: if isOwner(uid) && docId == 'config';
      allow create, update: if isOwner(uid) && docId == 'config' && validAiConfig(request.resource.data);
    }
    // ---- end AI chat settings ----

    match /reports/{reportId} {
      allow read, update, delete: if false;
      allow create: if isAdult()
        && countsTowardsLimit(reportId)
        && request.resource.data.keys().hasOnly(['reporterId', 'targetId', 'reason', 'details', 'matchId', 'createdAt', 'status'])
        && request.resource.data.reporterId == me()
        && request.resource.data.targetId is string
        && request.resource.data.targetId != me()
        && request.resource.data.reason in ['fake_profile', 'inappropriate_photos', 'harassment', 'underage',
             'spam_scam', 'offensive_messages', 'safety_concern', 'other']
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 1000
        && (request.resource.data.matchId == null || request.resource.data.matchId is string)
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'open';
    }
  }
}
